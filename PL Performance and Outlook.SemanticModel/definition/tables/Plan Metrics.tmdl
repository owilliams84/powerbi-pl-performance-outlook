/// Measures behind page 02, Against Plan. Generated by etl/plan_model.py - edit that, not this.
table 'Plan Metrics'
	lineageTag: 9c56bae1-a41a-54f5-b245-5f1df5300948

	/// The year on screen; the page forces a single year.
	measure 'Plan Year' = MAX('Date'[Year])
		formatString: 0
		lineageTag: d3887c7c-26b6-55bd-afea-9691908b3dfa

	measure 'Plan Choice' = SELECTEDVALUE('Plan Comparison'[Comparison], "Budget")
		lineageTag: 35c948d6-06e5-5568-abf5-77f3c09d3fee

	/// How the comparison reads inside a sentence: 'budget', or the prior year's number.
	measure 'Plan Comparison Label' = IF([Plan Choice] = "Budget", "budget", FORMAT([Plan Year] - 1, "0"))
		lineageTag: 319c547c-bda1-57e1-8773-4d891670bae5

	/// False for 2018: there is no budget before 2019 and no year before 2018.
	measure 'Plan Comparison Available' =
			VAR Y = [Plan Year]
			RETURN
			    IF(
			        [Plan Choice] = "Budget",
			        NOT ISEMPTY(
			            CALCULATETABLE(
			                Financials,
			                REMOVEFILTERS(Scenario), Scenario[Scenario] = "Budget",
			                REMOVEFILTERS('Date'), 'Date'[Year] = Y,
			                REMOVEFILTERS('Business Unit'), REMOVEFILTERS(Account)
			            )
			        ),
			        Y - 1 >= CALCULATE(MIN('Date'[Year]), REMOVEFILTERS('Date'))
			    )
		lineageTag: cf162fc4-56c0-5047-a2aa-4213dd2988df

	/// Actuals, January to the October close, signed as posted.
	measure '_Plan Actual' = CALCULATE(SUM(Financials[Amount]), REMOVEFILTERS(Scenario), Scenario[Scenario] = "Actual", 'Date'[Is YTD] = 1)
		formatString: #,0
		isHidden
		lineageTag: e2adf407-ac21-554b-9cd5-7addf14f55c8

	/// The same months, from the budget or from the prior year's actuals. The prior year replaces
	/// only the Year filter, so a month on a chart axis still applies.
	measure '_Plan Comparison' =
			VAR Y = [Plan Year]
			RETURN
			    IF(
			        [Plan Comparison Available],
			        IF(
			            [Plan Choice] = "Budget",
			            CALCULATE(SUM(Financials[Amount]), REMOVEFILTERS(Scenario), Scenario[Scenario] = "Budget", 'Date'[Is YTD] = 1),
			            CALCULATE(SUM(Financials[Amount]), REMOVEFILTERS(Scenario), Scenario[Scenario] = "Actual", 'Date'[Is YTD] = 1, 'Date'[Year] = Y - 1)
			        )
			    )
		formatString: #,0
		isHidden
		lineageTag: 1efc3842-60bd-5bfc-9562-c0cdcf0d0799

	measure 'Revenue Actual' = CALCULATE([_Plan Actual], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "Revenue"), Account[Account_key])))
		formatString: #,0
		lineageTag: 4370aa55-fbff-52a6-97f4-c079be66d026

	measure 'Revenue Comparison' = CALCULATE([_Plan Comparison], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "Revenue"), Account[Account_key])))
		formatString: #,0
		lineageTag: 28d218d5-569f-5a37-b1a5-24f438cbde37

	/// Actual less comparison. Positive is favourable: the line is signed as posted.
	measure 'Revenue Variance' = IF([Plan Comparison Available], [Revenue Actual] - [Revenue Comparison])
		formatString: #,0
		lineageTag: d60aec68-c5c6-5b1b-b33f-3274f3197f6a

	measure 'Revenue Variance %' = DIVIDE([Revenue Variance], ABS([Revenue Comparison]))
		formatString: 0.0%
		lineageTag: f940ccaa-7ede-5384-9059-ae6b1f10a37b

	measure 'Gross Profit Actual' = CALCULATE([_Plan Actual], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "Gross Profit"), Account[Account_key])))
		formatString: #,0
		lineageTag: 009411cb-0fe3-5dba-be62-1b6e75634104

	measure 'Gross Profit Comparison' = CALCULATE([_Plan Comparison], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "Gross Profit"), Account[Account_key])))
		formatString: #,0
		lineageTag: 5e84a736-a2b4-5608-8da1-cd9eef5c098c

	/// Actual less comparison. Positive is favourable: the line is signed as posted.
	measure 'Gross Profit Variance' = IF([Plan Comparison Available], [Gross Profit Actual] - [Gross Profit Comparison])
		formatString: #,0
		lineageTag: b189a422-d8de-5225-b00c-438a7f52c5b3

	measure 'Gross Profit Variance %' = DIVIDE([Gross Profit Variance], ABS([Gross Profit Comparison]))
		formatString: 0.0%
		lineageTag: 02f56e94-c6c8-55f7-946f-1ffc67a35521

	measure 'EBITDA Actual' = CALCULATE([_Plan Actual], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "EBITDA"), Account[Account_key])))
		formatString: #,0
		lineageTag: 7e93c2d3-a612-5213-9af7-db092daf8af8

	measure 'EBITDA Comparison' = CALCULATE([_Plan Comparison], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "EBITDA"), Account[Account_key])))
		formatString: #,0
		lineageTag: 9750a18f-8f74-5f07-8b8a-8c2272a08b95

	/// Actual less comparison. Positive is favourable: the line is signed as posted.
	measure 'EBITDA Variance' = IF([Plan Comparison Available], [EBITDA Actual] - [EBITDA Comparison])
		formatString: #,0
		lineageTag: dccd6679-0b49-5347-bc93-181cd8835d4a

	measure 'EBITDA Variance %' = DIVIDE([EBITDA Variance], ABS([EBITDA Comparison]))
		formatString: 0.0%
		lineageTag: 60a581ab-6e42-5cc3-8ecb-f2841c61b7aa

	measure 'Net Income Actual' = CALCULATE([_Plan Actual], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "Net Income"), Account[Account_key])))
		formatString: #,0
		lineageTag: 5e1ff5ba-5aec-51c0-b0e4-781d32a3cf14

	measure 'Net Income Comparison' = CALCULATE([_Plan Comparison], KEEPFILTERS(TREATAS(CALCULATETABLE(VALUES('PL Bridge'[Account_key]), REMOVEFILTERS('P&L Line'), 'P&L Line'[PL Line] = "Net Income"), Account[Account_key])))
		formatString: #,0
		lineageTag: f54bacc1-ad3d-5ff1-ba20-6462d1613f18

	/// Actual less comparison. Positive is favourable: the line is signed as posted.
	measure 'Net Income Variance' = IF([Plan Comparison Available], [Net Income Actual] - [Net Income Comparison])
		formatString: #,0
		lineageTag: ea1297b1-2c87-51a9-a970-43032139df4b

	measure 'Net Income Variance %' = DIVIDE([Net Income Variance], ABS([Net Income Comparison]))
		formatString: 0.0%
		lineageTag: 191383a1-971f-5399-85fb-f02123cc07b7

	measure 'EBITDA Margin Actual' = DIVIDE([EBITDA Actual], [Revenue Actual])
		formatString: 0.0%
		lineageTag: dfa81884-fe05-56f2-bb88-9e8f2e25384b

	measure 'EBITDA Margin Comparison' = DIVIDE([EBITDA Comparison], [Revenue Comparison])
		formatString: 0.0%
		lineageTag: e18966df-cbe5-557f-8092-8e2f502f1b13

	measure 'Gross Margin Actual' = DIVIDE([Gross Profit Actual], [Revenue Actual])
		formatString: 0.0%
		lineageTag: 6e8fae7e-467b-5abb-8eb2-c797e3c0857a

	measure 'Gross Margin Comparison' = DIVIDE([Gross Profit Comparison], [Revenue Comparison])
		formatString: 0.0%
		lineageTag: 76d27a5a-5b47-54b1-87db-25f3cc47051d

	measure 'Plan Chart Metric' = SELECTEDVALUE('Plan Chart Line'[Line], "EBITDA")
		lineageTag: c020810d-3014-5dac-bbd9-665876cdefe6

	measure 'Chart Actual' = IF([Plan Chart Metric] = "Revenue", [Revenue Actual], [EBITDA Actual])
		formatString: #,0
		lineageTag: ca04979f-ff49-5687-a520-732187c4951d

	measure 'Chart Comparison' = IF([Plan Chart Metric] = "Revenue", [Revenue Comparison], [EBITDA Comparison])
		formatString: #,0
		lineageTag: 21b91120-1813-515a-ad0c-728022b47b43

	measure 'Chart Variance' = IF([Plan Chart Metric] = "Revenue", [Revenue Variance], [EBITDA Variance])
		formatString: #,0
		lineageTag: ee52810f-49ec-5b88-be39-2293c540ce89

	measure 'Chart Variance Colour' = IF([Chart Variance] >= 0, "#1E7A4C", "#B3261E")
		lineageTag: 10faac0d-335f-5a53-aa04-8b6610e8a683

	measure 'EBITDA Variance Colour' = IF([EBITDA Variance] >= 0, "#1E7A4C", "#B3261E")
		lineageTag: 3b1fe41d-727c-5b18-9e08-9672f65fb212

	/// ALLSELECTED: Business Unit is on the filter panel, and ALL would ignore it.
	measure 'Units In Play' = IF([Plan Comparison Available], COUNTROWS(FILTER(ALLSELECTED('Business Unit'[Business Unit]), NOT ISBLANK([EBITDA Actual]) || NOT ISBLANK([EBITDA Comparison]))))
		formatString: 0
		lineageTag: 743373e2-a0af-5886-b878-de603ad6547c

	measure 'Units Ahead' = IF([Plan Comparison Available], COUNTROWS(FILTER(FILTER(ALLSELECTED('Business Unit'[Business Unit]), NOT ISBLANK([EBITDA Actual]) || NOT ISBLANK([EBITDA Comparison])), [EBITDA Variance] > 0)))
		formatString: 0
		lineageTag: db128fb2-2e70-56fb-b039-0384f9477e83

	/// Diverging bar for a unit's EBITDA variance, scaled to the largest among the units selected.
	measure 'Unit EBITDA Bar' =
			VAR Change = [EBITDA Variance]
			VAR Scale = MAXX(FILTER(ALLSELECTED('Business Unit'[Business Unit]), NOT ISBLANK([EBITDA Actual]) || NOT ISBLANK([EBITDA Comparison])), ABS([EBITDA Variance]))
			VAR W = DIVIDE(ABS(Change), Scale) * 56
			VAR X = IF(Change >= 0, 60, 60 - W)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<line x1='60' y1='0' x2='60' y2='16' stroke='#667284'/>"
			        & "<rect x='" & FORMAT(X, "0.0") & "' y='3' width='" & FORMAT(W, "0.0") & "' height='10' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'/>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Change) && HASONEVALUE('Business Unit'[Business Unit]), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: f9d24742-8e08-5967-8b28-0ed887d75f9a

	measure 'Unit Variance % Label' =
			VAR P = [EBITDA Variance %]
			RETURN IF(NOT ISBLANK([EBITDA Variance]), FORMAT(P, "+0.0%;-0.0%;0.0%"))
		lineageTag: 0f9c9b8f-98d5-59e0-82aa-12bbe0c84b89

	/// Unsigned for display: an account is either income or cost, and the effect column carries the sign.
	measure 'Account Actual' = ABS([_Plan Actual])
		formatString: #,0
		lineageTag: 9fb0c3e3-ce9c-5c5a-9b5d-69e92b2c3f9d

	measure 'Account Comparison' = ABS([_Plan Comparison])
		formatString: #,0
		lineageTag: 17df071f-aa10-5904-873a-5531c8ce6bee

	/// Effect on profit: positive when income beat the comparison or a cost came in under it.
	measure 'Account Effect' = IF([Plan Comparison Available], [_Plan Actual] - [_Plan Comparison])
		formatString: #,0
		lineageTag: 7ffdf502-7bbb-5a6a-84e7-88b7ed49a15b

	/// Accounts with any posting in either period.
	measure 'Accounts In Play' = IF([Plan Comparison Available], COUNTROWS(FILTER(ALL(Account[SubAccount]), NOT ISBLANK([_Plan Actual]) || NOT ISBLANK([_Plan Comparison]))))
		formatString: 0
		lineageTag: e4c35b8e-72d3-5f3d-bfd0-39165fa8be6e

	measure 'Accounts Favourable' = IF([Plan Comparison Available], COUNTROWS(FILTER(FILTER(ALL(Account[SubAccount]), NOT ISBLANK([_Plan Actual]) || NOT ISBLANK([_Plan Comparison])), [Account Effect] > 0)))
		formatString: 0
		lineageTag: 3305f84a-a0b5-5647-b06a-bc5caeaf8000

	/// Position by effect on profit, from the top or the bottom as 'Account Ranking' says. The table
	/// keeps ranks 1 to 8 with a visual-level filter. ALL pool: that filter narrows ALLSELECTED.
	measure 'Account Effect Rank' =
			VAR Direction = SELECTEDVALUE('Account Ranking'[Show], "Bottom")
			VAR Pool = FILTER(ALL(Account[SubAccount]), NOT ISBLANK([_Plan Actual]) || NOT ISBLANK([_Plan Comparison]))
			VAR Me = [Account Effect]
			RETURN
			    IF(
			        HASONEVALUE(Account[SubAccount]) && [Plan Comparison Available]
			            && (NOT ISBLANK([_Plan Actual]) || NOT ISBLANK([_Plan Comparison])),
			        IF(
			            Direction = "Top",
			            COUNTROWS(FILTER(Pool, [Account Effect] > Me)) + 1,
			            COUNTROWS(FILTER(Pool, [Account Effect] < Me)) + 1
			        )
			    )
		formatString: 0
		lineageTag: b2994211-aee8-54b6-b72c-640e3326bed3

	/// Diverging bar for an account's effect on profit, one scale for Top and Bottom.
	measure 'Account Effect Bar' =
			VAR Change = [Account Effect]
			VAR Scale = MAXX(FILTER(ALL(Account[SubAccount]), NOT ISBLANK([_Plan Actual]) || NOT ISBLANK([_Plan Comparison])), ABS([Account Effect]))
			VAR W = DIVIDE(ABS(Change), Scale) * 56
			VAR X = IF(Change >= 0, 60, 60 - W)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16' viewBox='0 0 120 16'>"
			        & "<line x1='60' y1='0' x2='60' y2='16' stroke='#667284'/>"
			        & "<rect x='" & FORMAT(X, "0.0") & "' y='3' width='" & FORMAT(W, "0.0") & "' height='10' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'/>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK([Account Effect Rank]), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 6e626bc4-13b7-56c1-9a52-3e097110cdde

	measure 'Account Effect % Label' =
			VAR C = [_Plan Comparison]
			VAR P = DIVIDE([Account Effect], ABS(C))
			RETURN
			    IF(
			        NOT ISBLANK([Account Effect Rank]),
			        IF(ISBLANK(C) || C = 0, "new", FORMAT(P, "+0.0%;-0.0%;0.0%"))
			    )
		lineageTag: 7284f6a8-7be1-53d4-8e93-bf54f0e0dcdc

	measure 'Account Effect Colour' = IF([Account Effect] >= 0, "#1E7A4C", "#B3261E")
		lineageTag: 6ee2de24-2bed-5571-ac9c-f08baf27c1b2

	measure 'EBITDA Actual $000' = ROUND(DIVIDE([EBITDA Actual], 1000), 0)
		formatString: #,0;-#,0;0
		lineageTag: de4ca531-7d9f-524f-9fdb-d933f344f853

	measure 'EBITDA Comparison $000' = ROUND(DIVIDE([EBITDA Comparison], 1000), 0)
		formatString: #,0;-#,0;0
		lineageTag: 45a7dac5-e2f3-5b08-b3c3-6b48edd1e72d

	measure 'EBITDA Variance $000' = ROUND(DIVIDE([EBITDA Variance], 1000), 0)
		formatString: #,0;-#,0;0
		lineageTag: e60a3d01-c285-5b12-b28e-ad3b5e707840

	measure 'Account Actual $000' = ROUND(DIVIDE([Account Actual], 1000), 0)
		formatString: #,0;-#,0;0
		lineageTag: ed6751c3-7062-52ba-8246-b6e8b561a47e

	measure 'Account Comparison $000' = ROUND(DIVIDE([Account Comparison], 1000), 0)
		formatString: #,0;-#,0;0
		lineageTag: 0bd95882-3d25-5073-8ddf-370c145dd063

	measure 'Account Effect $000' = ROUND(DIVIDE([Account Effect], 1000), 0)
		formatString: #,0;-#,0;0
		lineageTag: 6b4ea996-1596-5fb5-bb27-81061696689f

	/// Judged on the margin, not on the two growth rates: revenue +37.7% against EBITDA +4.0% first
	/// read as 'costs moved in step with sales' while the margin fell 7.6 points.
	measure 'Plan Standfirst' =
			VAR Y = [Plan Year]
			VAR C = [Plan Comparison Label]
			VAR RP = [Revenue Variance %]
			VAR EP = [EBITDA Variance %]
			VAR MarginMove = [EBITDA Margin Actual] - [EBITDA Margin Comparison]
			RETURN
			    IF(
			        NOT [Plan Comparison Available],
			        Y & " has nothing to compare with: there is no budget before 2019 and no year before 2018.",
			        "January to October " & Y & ": revenue " & IF(RP >= 0, "ahead of ", "behind ") & C & " by "
			            & FORMAT(ABS(RP), "0.0%") & ", EBITDA " & IF(EP >= 0, "ahead", "behind") & " by " & FORMAT(ABS(EP), "0.0%") & ". "
			            & IF(
			                ABS(MarginMove) < 0.01,
			                "The EBITDA margin held at " & FORMAT([EBITDA Margin Actual], "0.0%") & ": costs moved with sales.",
			                "The EBITDA margin " & IF(MarginMove < 0, "fell", "rose") & " from " & FORMAT([EBITDA Margin Comparison], "0.0%")
			                    & " to " & FORMAT([EBITDA Margin Actual], "0.0%") & IF(MarginMove < 0, ": costs took a larger share of revenue.", ": costs took a smaller share of revenue.")
			            )
			    )
		lineageTag: 3b913851-860a-5573-bec8-4aed7b923063

	measure 'Plan Title Line Chart' = [Plan Chart Metric] & " by month, actual against " & [Plan Comparison Label]
		lineageTag: 402c6dd6-8e79-5b00-9684-5c69d64a5a53

	measure 'Plan Subtitle Line Chart' =
			VAR Ahead = COUNTROWS(FILTER(VALUES('Date'[Month No]), [Chart Variance] > 0))
			VAR Months = COUNTROWS(FILTER(VALUES('Date'[Month No]), NOT ISBLANK([Chart Actual])))
			RETURN
			    IF([Plan Comparison Available], "Ahead of " & [Plan Comparison Label] & " in " & Ahead & " of " & Months & " months")
		lineageTag: 105ad6d6-ba5a-56d3-8375-dca9ede53236

	measure 'Plan Title Variance Chart' = "Which months moved " & [Plan Chart Metric]
		lineageTag: f621b9dd-1aae-5a58-b403-afdc3021415b

	measure 'Plan Subtitle Variance Chart' =
			VAR ByMonth = FILTER(ADDCOLUMNS(VALUES('Date'[Month No]), "@V", [Chart Variance]), NOT ISBLANK([@V]))
			VAR Worst = TOPN(1, ByMonth, ABS([@V]), DESC)
			VAR V = MAXX(Worst, [@V])
			VAR MonthName = FORMAT(DATE(2000, MAXX(Worst, 'Date'[Month No]), 1), "mmm")
			RETURN
			    IF(
			        [Plan Comparison Available],
			        [Plan Chart Metric] & " less " & [Plan Comparison Label] & ", by month: " & MonthName & " moved most ("
			            & IF(V < 0, "-$", "+$") & FORMAT(ABS(V) / 1000, "#,0") & "k)"
			    )
		lineageTag: ed09d98a-3810-5b3d-a88e-3b076e0659c9

	measure 'Plan Title Unit Table' = "EBITDA by business unit, against " & [Plan Comparison Label]
		lineageTag: 322c3c73-9a9b-5ab0-91f5-14c86dd6732f

	measure 'Plan Subtitle Unit Table' =
			VAR Worst = TOPN(1, ADDCOLUMNS(FILTER(ALLSELECTED('Business Unit'[Business Unit]), NOT ISBLANK([EBITDA Actual]) || NOT ISBLANK([EBITDA Comparison])), "@V", [EBITDA Variance]), [@V], ASC)
			RETURN
			    IF(
			        [Plan Comparison Available],
			        [Units Ahead] & " of " & [Units In Play] & " ahead; " & MAXX(Worst, 'Business Unit'[Business Unit])
			            & IF(MAXX(Worst, [@V]) < 0, " is furthest behind", " is least ahead")
			    )
		lineageTag: a939a7ed-9c51-54a9-8e19-44a40618a02e

	measure 'Plan Title Account Table' =
			IF(
			    SELECTEDVALUE('Account Ranking'[Show], "Bottom") = "Top",
			    "The 8 accounts that helped profit most against " & [Plan Comparison Label],
			    "The 8 accounts that cost profit most against " & [Plan Comparison Label]
			)
		lineageTag: d532041b-7930-58cb-98e9-7e49ba26ca5d

	measure 'Plan Subtitle Account Table' = "Effect on profit: income above or costs below " & [Plan Comparison Label] & " counts as positive"
		lineageTag: eca4c6b9-5350-579a-bcc9-2f4b503a97af

	measure 'Plan Filter Summary' =
			VAR Names =
			    FILTER(
			        {
			            ("region", ISFILTERED('Business Unit'[Region]), 1),
			            ("business unit", ISFILTERED('Business Unit'[Business Unit]), 2)
			        },
			        [Value2]
			    )
			RETURN
			    IF(COUNTROWS(Names) = 0, "No filters applied", "Filtered by " & CONCATENATEX(Names, [Value1], ", ", [Value3], ASC))
		lineageTag: 359e0631-b9b9-5a95-ba73-5a3ce3645f1c

	/// Revenue card: actual, the change on the comparison, and a ring of actual as a share of it.
	measure 'Plan Card Revenue' =
			VAR Y = [Plan Year]
			VAR C = [Plan Comparison Label]
			VAR A = [Revenue Actual]
			VAR B = [Revenue Comparison]
			VAR P = [Revenue Variance %]
			VAR GM = [Gross Margin Actual]
			VAR GMC = [Gross Margin Comparison]
			VAR NI = [Net Income Actual]
			VAR NIP = [Net Income Variance %]
			VAR NIV = [Net Income Variance]
			VAR Ratio = DIVIDE(A, B)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "REVENUE, JAN-OCT " & Y & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & IF(A < 0, "&#8722;$", "$") & FORMAT(ABS(A) / 1000, "#,0") & "k" & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & IF(ISBLANK(P), "new", IF(P < 0, "&#8722;", "+") & FORMAT(ABS(P), "0.0%")) & " on " & C & " (" & IF(B < 0, "&#8722;$", "$") & FORMAT(ABS(B) / 1000, "#,0") & "k" & ")" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Gross margin " & FORMAT(GM, "0.0%") & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(GM - GMC >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(GM - GMC < 0, "&#8722;", "+") & FORMAT(ABS(GM - GMC) * 100, "0.0") & "pp" & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Net income " & IF(NI < 0, "&#8722;$", "$") & FORMAT(ABS(NI) / 1000, "#,0") & "k" & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(NIV >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(ISBLANK(NIP), "new", IF(NIP < 0, "&#8722;", "+") & FORMAT(ABS(NIP), "0.0%")) & "</text>"
			    & "<circle cx='286' cy='42' r='26' stroke='#E3E7EF' stroke-width='7' fill='none'/>" & IF(MIN(Ratio, 1) > 0, "<path d='M286,16 A26,26 0 " & IF(MIN(Ratio, 1) > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(MIN(Ratio, 1), 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(MIN(Ratio, 1), 0.9999) - PI() / 2), "0.00") & "' stroke='#111F38' stroke-width='7' fill='none'/>") & IF(Ratio - 1 > 0, "<path d='M286,16 A26,26 0 " & IF(Ratio - 1 > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "' stroke='#C9A227' stroke-width='7' fill='none'/>") & "<text x='286' y='47' font-size='13' font-weight='700' text-anchor='middle' fill='#0A0917'>" & FORMAT(Ratio, "0%") & "</text>"
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>REVENUE</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Plan Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 6fbdd67e-ba86-5cf7-9ff7-01e10b71d665

	/// EBITDA card: actual, the change, the margin move in points, and the gap or headroom.
	measure 'Plan Card EBITDA' =
			VAR Y = [Plan Year]
			VAR C = [Plan Comparison Label]
			VAR A = [EBITDA Actual]
			VAR B = [EBITDA Comparison]
			VAR P = [EBITDA Variance %]
			VAR V = [EBITDA Variance]
			VAR EM = [EBITDA Margin Actual]
			VAR EMC = [EBITDA Margin Comparison]
			VAR Ratio = DIVIDE(A, B)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "EBITDA, JAN-OCT " & Y & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & IF(A < 0, "&#8722;$", "$") & FORMAT(ABS(A) / 1000, "#,0") & "k" & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & IF(ISBLANK(P), "new", IF(P < 0, "&#8722;", "+") & FORMAT(ABS(P), "0.0%")) & " on " & C & " (" & IF(B < 0, "&#8722;$", "$") & FORMAT(ABS(B) / 1000, "#,0") & "k" & ")" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "EBITDA margin " & FORMAT(EM, "0.0%") & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(EM - EMC >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(EM - EMC < 0, "&#8722;", "+") & FORMAT(ABS(EM - EMC) * 100, "0.0") & "pp" & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & IF(V < 0, "Gap to close", "Headroom") & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(V >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(V < 0, "&#8722;$", "+$") & FORMAT(ABS(V) / 1000, "#,0") & "k" & "</text>"
			    & "<circle cx='286' cy='42' r='26' stroke='#E3E7EF' stroke-width='7' fill='none'/>" & IF(MAX(MIN(Ratio, 1), 0) > 0, "<path d='M286,16 A26,26 0 " & IF(MAX(MIN(Ratio, 1), 0) > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(MAX(MIN(Ratio, 1), 0), 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(MAX(MIN(Ratio, 1), 0), 0.9999) - PI() / 2), "0.00") & "' stroke='#111F38' stroke-width='7' fill='none'/>") & IF(Ratio - 1 > 0, "<path d='M286,16 A26,26 0 " & IF(Ratio - 1 > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "' stroke='#C9A227' stroke-width='7' fill='none'/>") & "<text x='286' y='47' font-size='13' font-weight='700' text-anchor='middle' fill='#0A0917'>" & FORMAT(Ratio, "0%") & "</text>"
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>EBITDA</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Plan Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: dcf50254-298b-5f45-b27b-d387fc782430

	/// One tile per business unit in the selection, alphabetical, green ahead and red behind.
	measure 'Plan Card Units' =
			VAR C = [Plan Comparison Label]
			VAR Units = ADDCOLUMNS(FILTER(ALLSELECTED('Business Unit'[Business Unit]), NOT ISBLANK([EBITDA Actual]) || NOT ISBLANK([EBITDA Comparison])), "@V", [EBITDA Variance])
			VAR N = COUNTROWS(Units)
			VAR BestRow = TOPN(1, Units, [@V], DESC, 'Business Unit'[Business Unit], ASC)
			VAR WorstRow = TOPN(1, Units, [@V], ASC, 'Business Unit'[Business Unit], ASC)
			VAR BestValue = MAXX(BestRow, [@V])
			VAR WorstValue = MAXX(WorstRow, [@V])
			VAR Tiles =
			    CONCATENATEX(
			        Units,
			        VAR UnitName = 'Business Unit'[Business Unit]
			        VAR I = COUNTROWS(FILTER(Units, 'Business Unit'[Business Unit] < UnitName))
			        VAR X = 196 + I * 18
			        RETURN
			            "<rect x='" & X & "' y='26' width='15' height='34' rx='2' fill='" & IF([@V] >= 0, "#1E7A4C", "#B3261E") & "'/>"
			                & "<text x='" & X + 7.5 & "' y='48' font-size='9' font-weight='700' text-anchor='middle' fill='#FFFFFF'>"
			                & LEFT(UnitName, 1) & "</text>",
			        ""
			    )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "UNITS AHEAD ON EBITDA" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT([Units Ahead], "0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & "of " & N & IF(N = 1, " business unit", " business units") & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Best &#183; " & MAXX(BestRow, 'Business Unit'[Business Unit]) & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(BestValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(BestValue < 0, "&#8722;$", "+$") & FORMAT(ABS(BestValue) / 1000, "#,0") & "k" & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Weakest &#183; " & MAXX(WorstRow, 'Business Unit'[Business Unit]) & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(WorstValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(WorstValue < 0, "&#8722;$", "+$") & FORMAT(ABS(WorstValue) / 1000, "#,0") & "k" & "</text>"
			    & Tiles
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>UNITS AHEAD ON EBITDA</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Plan Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 96b449e9-d394-5984-91f8-f32fec0e1425

	/// Every account with postings as a bar, sorted from most to least helpful to profit.
	measure 'Plan Card Accounts' =
			VAR C = [Plan Comparison Label]
			VAR Accounts = ADDCOLUMNS(FILTER(ALL(Account[SubAccount]), NOT ISBLANK([_Plan Actual]) || NOT ISBLANK([_Plan Comparison])), "@V", [Account Effect])
			VAR Scale = MAXX(Accounts, ABS([@V]))
			VAR BestRow = TOPN(1, Accounts, [@V], DESC, Account[SubAccount], ASC)
			VAR WorstRow = TOPN(1, Accounts, [@V], ASC, Account[SubAccount], ASC)
			VAR BestValue = MAXX(BestRow, [@V])
			VAR WorstValue = MAXX(WorstRow, [@V])
			VAR Bars =
			    "<line x1='176' y1='46' x2='320' y2='46' stroke='#E3E7EF'/>"
			        & CONCATENATEX(
			            Accounts,
			            VAR Change = [@V]
			            VAR I = COUNTROWS(FILTER(Accounts, [@V] > Change))
			            VAR H = MAX(1.5, 20 * DIVIDE(ABS(Change), Scale))
			            RETURN
			                "<rect x='" & FORMAT(176 + I * 6.8, "0.0") & "' y='" & FORMAT(IF(Change >= 0, 46 - H, 46), "0.0")
			                    & "' width='5' height='" & FORMAT(H, "0.0") & "' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'/>",
			            ""
			        )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "ACCOUNTS BETTER THAN " & UPPER(C) & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT([Accounts Favourable], "0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & "of " & [Accounts In Play] & " accounts with postings" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Best &#183; " & LEFT(MAXX(BestRow, Account[SubAccount]), 26) & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(BestValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(BestValue < 0, "&#8722;$", "+$") & FORMAT(ABS(BestValue) / 1000, "#,0") & "k" & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Worst &#183; " & LEFT(MAXX(WorstRow, Account[SubAccount]), 26) & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(WorstValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(WorstValue < 0, "&#8722;$", "+$") & FORMAT(ABS(WorstValue) / 1000, "#,0") & "k" & "</text>"
			    & Bars
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>ACCOUNTS</text><text x='16' y='64' font-size='13' fill='#4A5768'>Nothing to compare with for this year.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Plan Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 76773b7b-30a5-5bda-b9bd-f06ee20a26d8

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 052d4e44-6d2f-5c3d-b9ce-733d14324dbc
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition 'Plan Metrics' = calculated
		mode: import
		source = ROW("Placeholder", "")
